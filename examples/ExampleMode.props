<Project>

  <!--
    The two compilation products of the example sources, selected by the build configuration:

      Smoke (Release)  the automated half: every example builds its scene, checks it and returns an
                       exit code. No window is registered with the host and no event loop runs.
      View  (Debug)    the interactive half: every example builds its scene, hands the window to the
                       host and lets QApplication run it until the last window closes.

    Debug and Release stay usable and are aliases: Release -> Smoke, Debug -> View. Import this
    file from the hosting project and from every example executable; the constants are what compile
    the ExampleContext surface down to one mode (Check/ExitCode or Show) and what keeps the two
    products free of each other's code.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Smoke' or '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);QTSHARP_EXAMPLE_SMOKE</DefineConstants>
    <QtSharpExampleMode>Smoke</QtSharpExampleMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'View' or '$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);QTSHARP_EXAMPLE_VIEW</DefineConstants>
    <QtSharpExampleMode>View</QtSharpExampleMode>
  </PropertyGroup>

  <!-- A third configuration would silently compile an ExampleContext with neither surface; fail. -->
  <Target Name="QtSharpExampleModeCheck" BeforeTargets="CoreCompile"
          Condition="'$(QtSharpExampleMode)' == ''">
    <Error Text="Unknown example configuration '$(Configuration)'. Use Smoke (or Release) or View (or Debug)." />
  </Target>

</Project>
