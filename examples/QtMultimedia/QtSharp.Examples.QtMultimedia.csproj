<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ports of Qt's official QtMultimedian examples, as one executable. Each example is a static class
       registered with [Example("...")] and found by ExampleHost; this project holds the only Main and
       the only QApplication. The binding is compiled into the QtSharp.Api assemblies, so
       QtSharp.Api.props is imported with compilation off. ExampleMode.props selects Smoke or View
       and defines the matching constant for the example sources. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>QtSharp.Examples.QtMultimedia</AssemblyName>
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <Import Project="..\..\QtSharp.Api.props" />
  <Import Project="..\ExampleMode.props" />

  <ItemGroup>
    <ProjectReference Include="..\hosting\QtSharp.Examples.Hosting.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Runtime\QtSharp.Runtime.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Multimedia\QtSharp.Multimedia.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Positioning\QtSharp.Positioning.csproj" />
  </ItemGroup>

  <!-- The QtMultimedia extension's native glue and Qt runtime plugin, the way the package's
       buildTransitive would copy them for a consumer. QtPositioning comes along because the
       Multimedia classes reference it. -->
  <Target Name="CopyQtMultimediaNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <QtMultimediaNative Include="..\..\out\api-modules\qtmultimedia\$(QtSharpNativePrefix)QtSharp.QtMultimedia.Native$(QtSharpNativeSuffix)" />
      <QtMultimediaPlugin Include="$(QtRuntimeDir)\plugins\multimedia\*.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <QtPositioningNative Include="..\..\out\api-modules\qtpositioning\$(QtSharpNativePrefix)QtSharp.QtPositioning.Native$(QtSharpNativeSuffix)" />
    </ItemGroup>
    <Copy SourceFiles="@(QtMultimediaNative);@(QtPositioningNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QtMultimediaPlugin)" DestinationFolder="$(OutDir)multimedia\" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

</Project>
