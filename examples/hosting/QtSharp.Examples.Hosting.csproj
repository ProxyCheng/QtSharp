<Project Sdk="Microsoft.NET.Sdk">

  <!-- The example hosting library: [Example]/discovery, ExampleContext, ExampleHost and the pixel helper.
       It is compiled twice by configuration - QTSHARP_EXAMPLE_SMOKE or QTSHARP_EXAMPLE_VIEW from
       examples/ExampleMode.props - so the ExampleContext surface an example sees is the surface that build
       has. Every module executable references this project, not a copy of its files. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>QtSharp.Examples.Hosting</AssemblyName>
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <Import Project="..\..\QtSharp.Api.props" />
  <Import Project="..\ExampleMode.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\nuget\QtSharp.Runtime\QtSharp.Runtime.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" />
  </ItemGroup>

</Project>
