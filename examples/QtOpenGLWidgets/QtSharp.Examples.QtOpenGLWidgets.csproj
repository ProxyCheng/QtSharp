<Project Sdk="Microsoft.NET.Sdk">

  <!-- The QtOpenGLWidgets modules' examples, as one executable: Qt's hellogl2, ported onto
       QOpenGLWidget + QOpenGLFunctions + QOpenGLShaderProgram. The binding is compiled into the
       QtSharp.Api assemblies, so QtSharp.Api.props is imported with compilation off; ExampleMode
       selects Smoke or View. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>QtSharp.Examples.QtOpenGLWidgets</AssemblyName>
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <Import Project="..\..\QtSharp.Api.props" />
  <Import Project="..\ExampleMode.props" />

  <ItemGroup>
    <ProjectReference Include="..\hosting\QtSharp.Examples.Hosting.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Runtime\QtSharp.Runtime.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtOpenGL\QtSharp.QtOpenGL.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtOpenGLWidgets\QtSharp.QtOpenGLWidgets.csproj" />
  </ItemGroup>

</Project>
