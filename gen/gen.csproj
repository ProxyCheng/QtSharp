<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>qtgen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The replacement front end: libclang through ClangSharp. See ApiModel2.cs. -->
    <PackageReference Include="ClangSharp" Version="21.1.8.2" />
    <PackageReference Include="libClangSharp.runtime.win-x64" Version="21.1.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CppSharp">
      <HintPath>..\lib\CppSharp.dll</HintPath>
    </Reference>
    <Reference Include="CppSharp.AST">
      <HintPath>..\lib\CppSharp.AST.dll</HintPath>
    </Reference>
    <Reference Include="CppSharp.Generator">
      <HintPath>..\lib\CppSharp.Generator.dll</HintPath>
    </Reference>
    <Reference Include="CppSharp.Parser">
      <HintPath>..\lib\CppSharp.Parser.dll</HintPath>
    </Reference>
    <Reference Include="CppSharp.Parser.CSharp">
      <HintPath>..\lib\CppSharp.Parser.CSharp.dll</HintPath>
    </Reference>
    <Reference Include="CppSharp.Runtime">
      <HintPath>..\lib\CppSharp.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\lib\native\CppSharp.CppParser.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\lib\native\Std-symbols.dll" CopyToOutputDirectory="PreserveNewest" />
    <ClangHeaders Include="..\lib\lib\clang\**\*" />
    <Content Include="@(ClangHeaders)" Link="lib\clang\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
