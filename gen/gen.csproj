<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The generator is an ordinary host tool: build it for the machine it runs on. The scripts
         resolve its output under bin/<Configuration>/net10.0/$(RuntimeIdentifier). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>qtgen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host-specific half of the generator: one file per platform family, no OS checks in
         the shared sources. -->
    <Compile Remove="HostPlatform.*.cs" />
    <Compile Include="HostPlatform.Windows.cs" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Compile Include="HostPlatform.Unix.cs" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The replacement front end: libclang through ClangSharp. See ClangExtractor.cs. The native
         libclang comes from the host's runtime package; `codegen` (which reads a checked-in model)
         never loads it, so a Linux build only needs it for `extract`. -->
    <PackageReference Include="ClangSharp" Version="21.1.8.4" />
    <PackageReference Include="libClangSharp.runtime.win-x64" Version="21.1.8.2" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="libClangSharp.runtime.linux-x64" Version="21.1.8.2" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- libClangSharp ships no builtin headers, so ClangExtractor.ResourceDir() borrows clang's from
         here and the whole tree is copied next to the executable. Do NOT delete lib/lib/clang. -->
    <ClangHeaders Include="../lib/lib/clang/**/*" />
    <Content Include="@(ClangHeaders)" Link="lib/clang/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
