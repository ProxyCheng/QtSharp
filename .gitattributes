* text=auto

# The API models are generated with LF and regen-api.ps1 compares them byte for byte, so they must
# not be smudged to CRLF on checkout (core.autocrlf=true does that to any text=auto file).
model/*.json text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.slnx text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
