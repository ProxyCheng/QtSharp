<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>qtgen-next</AssemblyName>
    <RootNamespace>QtSharp.Generator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Transitional: the model vocabulary tables (runtime structs, C++ struct names) live in
         the old generator assembly. They move into the shared model layer as the rewrite fills in. -->
    <ProjectReference Include="../gen/gen.csproj" />
  </ItemGroup>

</Project>
