<Project Sdk="Microsoft.NET.Sdk">

  <!-- Binding-specific tests, not official demos: ownership, the exception boundary,
       C#-declared signals/properties, value types, and the modules whose official examples are
       not ported yet (network, SVG/XML/print). The test app dispatches them under test-* names;
       the official demo catalog lives in demos/. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.BindingTests</AssemblyName>
    <RootNamespace>QtSharp.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <Import Project="..\QtSharp.Api.props" />

  <ItemGroup>
    <!-- One platform file per host, so the test sources never branch on the OS. -->
    <Compile Include="*.cs" Exclude="TestPlatform.Windows.cs;TestPlatform.Unix.cs" />
    <Compile Include="TestPlatform.Windows.cs" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Compile Include="TestPlatform.Unix.cs" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\demos\QtSharp.Demos.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Sql\QtSharp.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SQL-provider the substitute test uses; the package itself only depends on
         System.Data.Common. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
