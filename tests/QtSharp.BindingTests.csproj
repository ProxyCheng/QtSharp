<Project Sdk="Microsoft.NET.Sdk">

  <!-- Binding-specific tests, not official examples: ownership, the exception boundary,
       C#-declared signals/properties, value types, and the modules whose official examples are
       not ported yet. Each is a static class with [Test("test-*")]; testapp dispatches them.
       The official example catalog lives in examples/, one executable per module, and is not
       referenced here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.BindingTests</AssemblyName>
    <RootNamespace>QtSharp.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <Import Project="..\QtSharp.Api.props" />

  <ItemGroup>
    <!-- One platform file per host, so the test sources never branch on the OS. -->
    <Compile Include="*.cs" Exclude="TestPlatform.Windows.cs;TestPlatform.Unix.cs" />
    <Compile Include="TestPlatform.Windows.cs" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <Compile Include="TestPlatform.Unix.cs" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosting library for the shared pixel helper; the base modules come through it. -->
    <ProjectReference Include="..\examples\hosting\QtSharp.Examples.Hosting.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtNetwork\QtSharp.QtNetwork.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtSvg\QtSharp.QtSvg.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtSvgWidgets\QtSharp.QtSvgWidgets.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtPrintSupport\QtSharp.QtPrintSupport.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Multimedia\QtSharp.Multimedia.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Positioning\QtSharp.Positioning.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Qt3D\Modules\QtSharp.Qt3DExtras\QtSharp.Qt3DExtras.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Sql\QtSharp.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SQL-provider the substitute test uses; the package itself only depends on
         System.Data.Common. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

</Project>
