<Project>

  <!--
    The two compilation products of the demo sources, selected by the build configuration:

      Smoke (Release)  the automated half: every demo builds its scene, checks it and returns an
                       exit code. No window is registered with the host and no event loop runs.
      View  (Debug)    the interactive half: every demo builds its scene, hands the window to the
                       host and lets QApplication run it until the last window closes.

    Debug and Release stay usable and are aliases: Release -> Smoke, Debug -> View. Import this
    file from the hosting project and from every demo executable; the constants are what compile
    the DemoContext surface down to one mode (Check/ExitCode or Show) and what keeps the two
    products free of each other's code.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Smoke' or '$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);QTSHARP_DEMO_SMOKE</DefineConstants>
    <QtSharpDemoMode>Smoke</QtSharpDemoMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'View' or '$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);QTSHARP_DEMO_VIEW</DefineConstants>
    <QtSharpDemoMode>View</QtSharpDemoMode>
  </PropertyGroup>

  <!-- A third configuration would silently compile a DemoContext with neither surface; fail. -->
  <Target Name="QtSharpDemoModeCheck" BeforeTargets="CoreCompile"
          Condition="'$(QtSharpDemoMode)' == ''">
    <Error Text="Unknown demo configuration '$(Configuration)'. Use Smoke (or Release) or View (or Debug)." />
  </Target>

</Project>
