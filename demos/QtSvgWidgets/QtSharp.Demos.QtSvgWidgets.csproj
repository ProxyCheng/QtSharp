<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ports of Qt's official QtSvgWidgets examples, as one executable. Each demo is a static class
       registered with [Demo("...")] and found by DemoHost; this project holds the only Main and
       the only QApplication. The binding is compiled into the QtSharp.Api assemblies, so
       QtSharp.Api.props is imported with compilation off. DemoMode.props selects Smoke or View
       and defines the matching constant for the demo sources. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>QtSharp.Demos.QtSvgWidgets</AssemblyName>
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <Import Project="..\..\QtSharp.Api.props" />
  <Import Project="..\DemoMode.props" />

  <ItemGroup>
    <ProjectReference Include="..\hosting\QtSharp.Demos.Hosting.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Runtime\QtSharp.Runtime.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtSvg\QtSharp.QtSvg.csproj" />
    <ProjectReference Include="..\..\nuget\QtSharp.Api\Modules\QtSharp.QtSvgWidgets\QtSharp.QtSvgWidgets.csproj" />
  </ItemGroup>

</Project>
