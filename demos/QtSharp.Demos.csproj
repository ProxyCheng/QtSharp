<Project Sdk="Microsoft.NET.Sdk">

  <!-- The official Qt examples this repository has ported to C#, as a library.

       It references the ten base module assemblies (QtSharp.Api/Modules), exactly like a consumer
       of the package does - it does not compile the generated binding into itself. That keeps the
       IDE view of this project to its own files and runs the demos across the same assembly
       boundaries the package ships.

       An entry point is nothing but a reference:

           <ProjectReference Include="..\demos\QtSharp.Demos.csproj" />

       QtSharp.Api.props is still imported (with compilation off) for the native QtSharp.Api.dll and
       Qt DLLs it copies next to the executable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>QtSharp.Demos</AssemblyName>
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <Import Project="..\QtSharp.Api.props" />

  <ItemGroup>
    <ProjectReference Include="..\nuget\QtSharp.Runtime\QtSharp.Runtime.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtNetwork\QtSharp.QtNetwork.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtSql\QtSharp.QtSql.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtSvg\QtSharp.QtSvg.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtSvgWidgets\QtSharp.QtSvgWidgets.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtPrintSupport\QtSharp.QtPrintSupport.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtXml\QtSharp.QtXml.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtOpenGL\QtSharp.QtOpenGL.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Api\Modules\QtSharp.QtOpenGLWidgets\QtSharp.QtOpenGLWidgets.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.WebSockets\QtSharp.WebSockets.csproj" />
    <ProjectReference Include="..\nuget\QtSharp.Multimedia\QtSharp.Multimedia.csproj" />
  </ItemGroup>

</Project>
