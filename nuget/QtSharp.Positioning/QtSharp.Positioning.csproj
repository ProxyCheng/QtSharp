<Project Sdk="Microsoft.NET.Sdk">

  <!-- The QtPositioning extension module: the geo value types (QGeoCoordinate, QGeoRectangle,
       QGeoCircle, QGeoPath, QGeoPolygon, QGeoShape, QGeoAddress, QGeoLocation) and the position/
       satellite sources. One assembly, one package, against the core binding. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.QtPositioning</AssemblyName>
    <RootNamespace>QtSharp.QtPositioning</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Positioning.$(QtSharpPlatform)</PackageId>
    <Version>0.23.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>Qt Positioning for .NET, generated from the Qt 6.12 headers. References QtSharp.Api.</Description>
    <PackageTags>Qt;Qt6;QtPositioning;CSharp;dotnet;binding;interop;geo</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtSharpPositioningDir Condition="'$(QtSharpPositioningDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\qtpositioning</QtSharpPositioningDir>
    <QtSharpPositioningNativeDir Condition="'$(QtSharpPositioningNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\api-modules\qtpositioning</QtSharpPositioningNativeDir>
    <QtSharpPositioningNativeLinuxDir Condition="'$(QtSharpPositioningNativeLinuxDir)' == ''">$(QtSharpPositioningNativeDir)</QtSharpPositioningNativeLinuxDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(QtSharpPositioningDir)\generated\**\*.cs">
      <Link>Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Runtime\QtSharp.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\QtSharp.Api.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Positioning.Qt6\QtSharp.Positioning.Qt6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- NuGet only imports buildTransitive/<package id>.props and .targets, and the id
         carries the RID, so the files are packed under the platform-specific name. -->
    <None Include="buildTransitive\QtSharp.Positioning.props" Pack="true" PackagePath="buildTransitive/QtSharp.Positioning.$(QtSharpPlatform).props" />
    <None Include="buildTransitive\QtSharp.Positioning.targets" Pack="true" PackagePath="buildTransitive/QtSharp.Positioning.$(QtSharpPlatform).targets" />
    <None Include="$(QtSharpPositioningNativeDir)\QtSharp.QtPositioning.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" Condition="'$(QtSharpPlatform)' == 'win-x64' And Exists('$(QtSharpPositioningNativeDir)\QtSharp.QtPositioning.Native.dll')" />
    <None Include="$(QtSharpPositioningNativeLinuxDir)\libQtSharp.QtPositioning.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="'$(QtSharpPlatform)' == 'linux-x64' And Exists('$(QtSharpPositioningNativeLinuxDir)\libQtSharp.QtPositioning.Native.so')" />
  </ItemGroup>

  <Target Name="QtSharpPositioningPackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtSharpPositioningDir)\generated')" Text="The QtPositioning binding source is missing - run the code generator for model\qtsharp.qtpositioning.json." />
    <Error Condition="!Exists('$(QtSharpPositioningNativeDir)\QtSharp.QtPositioning.Native.dll') and !Exists('$(QtSharpPositioningNativeLinuxDir)\libQtSharp.QtPositioning.Native.so')" Text="The QtPositioning native glue is missing - run build-native-module for the qtpositioning module (Windows or Linux)." />
  </Target>

</Project>
