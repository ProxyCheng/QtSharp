<Project>

  <!-- The QtPositioning native glue next to the consumer's executable, on Build and on Publish. -->
  <Target Name="QtSharpPositioningCopyNativeDeps" AfterTargets="Build" Condition="'$(QtSharpNativeRid)' == 'win-x64'">
    <ItemGroup>
      <_QtSharpPositioningNative Include="$(QtSharpPositioningNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpPositioningNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpPositioningCopyNativeDepsPublish" AfterTargets="Publish" Condition="'$(QtSharpNativeRid)' == 'win-x64'">
    <ItemGroup>
      <_QtSharpPositioningNativePublish Include="$(QtSharpPositioningNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpPositioningNativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpPositioningCopyNativeDepsLinux" AfterTargets="Build" Condition="'$(QtSharpNativeRid)' == 'linux-x64'">
    <ItemGroup>
      <_QtSharpPositioningNativeLinux Include="$(QtSharpPositioningNativeDir)*.so*" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpPositioningNativeLinux)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpPositioningCopyNativeDepsLinuxPublish" AfterTargets="Publish" Condition="'$(QtSharpNativeRid)' == 'linux-x64'">
    <ItemGroup>
      <_QtSharpPositioningNativeLinuxPublish Include="$(QtSharpPositioningNativeDir)*.so*" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpPositioningNativeLinuxPublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
