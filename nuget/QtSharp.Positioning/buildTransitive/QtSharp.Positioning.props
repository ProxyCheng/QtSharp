<Project>

  <!-- Imported automatically for any project that references the QtSharp.Positioning package. It
       only declares where the native payload lives; the copy itself is in the targets. -->
  <PropertyGroup>
    <QtSharpPositioningNativeDir Condition="'$(QtSharpPositioningNativeDir)' == ''">$(MSBuildThisFileDirectory)..\tools\native\</QtSharpPositioningNativeDir>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

</Project>
