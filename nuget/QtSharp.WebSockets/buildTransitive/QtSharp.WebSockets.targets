<Project>

  <!-- The QtWebSockets native glue next to the consumer's executable, on Build and on Publish. -->
  <Target Name="QtSharpWebSocketsCopyNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <_QtSharpWebSocketsNative Include="$(QtSharpWebSocketsNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpWebSocketsNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpWebSocketsCopyNativeDepsPublish" AfterTargets="Publish">
    <ItemGroup>
      <_QtSharpWebSocketsNativePublish Include="$(QtSharpWebSocketsNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpWebSocketsNativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
