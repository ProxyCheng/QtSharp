<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SQL substitute package: the two Qt model classes the removed QtSql binding used to
       provide, implemented over ADO.NET instead. QSqlQueryModel/QSqlTableModel are
       QAbstractTableModel implementations - the interface Qt views consume - which is why a .NET
       data stack alone (EF Core/Sqlite) is not a substitute: it yields rows, not a Qt model.
       This project is hand-written (no generated code) and depends only on System.Data.Common. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.QtSql</AssemblyName>
    <RootNamespace>QtSharp.QtSql</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Sql.$(QtSharpPlatform)</PackageId>
    <Version>0.21.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>The Qt model classes QtSql used to bind - QSqlQueryModel and QSqlTableModel - implemented over ADO.NET (System.Data.Common), so a Qt view can show SQL data without a Qt SQL binding.</Description>
    <PackageTags>Qt;Qt6;Sql;ADO.NET;CSharp;dotnet;binding;interop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Runtime\QtSharp.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\QtSharp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
