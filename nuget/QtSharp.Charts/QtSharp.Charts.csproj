<Project Sdk="Microsoft.NET.Sdk">

  <!-- An *extension module*: QtCharts, bound as its own assembly and its own package against the
       core binding, the way PyQt6-Charts sits beside PyQt6 and PySide6-Addons beside PySide6.

       Nothing of the core is repeated here - not the runtime, not the core's classes, not the core's
       enums. This assembly references the core one and only carries QtCharts: `QChart` derives from
       the core's `QGraphicsWidget`, `QChartView` from the core's `QGraphicsView`, and its generated
       P/Invokes call QtSharp.Charts.Native.dll (the core's call QtSharp.Api.dll).

       The generated source is produced by running `qtgen codegen` on model/qtsharp.charts.json
       with the charts module selected; nuget/QtSharp.Qt3D is the same shape for a module family
       that spans several Qt include directories. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.Charts</AssemblyName>
    <RootNamespace>QtSharp.Charts</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Charts.$(QtSharpPlatform)</PackageId>
    <Version>0.24.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>Qt Charts for .NET, generated from the Qt 6.12 headers. References QtSharp.Api.</Description>
    <PackageTags>Qt;Qt6;QtCharts;CSharp;dotnet;binding;interop;charts</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtSharpChartsDir Condition="'$(QtSharpChartsDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\charts</QtSharpChartsDir>
    <QtSharpChartsNativeDir Condition="'$(QtSharpChartsNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\api-modules\charts</QtSharpChartsNativeDir>
    <!-- The Linux glue in a full checkout lives in the same directory; a release pack job can
         point it at the Ubuntu artifact. -->
    <QtSharpChartsNativeLinuxDir Condition="'$(QtSharpChartsNativeLinuxDir)' == ''">$(QtSharpChartsNativeDir)</QtSharpChartsNativeLinuxDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(QtSharpChartsDir)\generated\**\*.cs">
      <Link>Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- The compiler needs the base assemblies themselves, while the *package* only depends on
         QtSharp.Api (which contains them). PrivateAssets keeps the module projects out of the
         dependency list, ReferenceOutputAssembly=false keeps QtSharp.Api itself out of the compile
         graph (it has no output of its own). -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Runtime\QtSharp.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\QtSharp.Api.csproj" />
    <!-- The Qt Charts runtime is its companion package, like PyQt6-Charts-Qt6. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Charts.Qt6\QtSharp.Charts.Qt6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- NuGet only imports buildTransitive/<package id>.props and .targets, and the id
         carries the RID, so the files are packed under the platform-specific name. -->
    <None Include="buildTransitive\QtSharp.Charts.props" Pack="true" PackagePath="buildTransitive/QtSharp.Charts.$(QtSharpPlatform).props" />
    <None Include="buildTransitive\QtSharp.Charts.targets" Pack="true" PackagePath="buildTransitive/QtSharp.Charts.$(QtSharpPlatform).targets" />
    <None Include="$(QtSharpChartsNativeDir)\QtSharp.Charts.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" Condition="'$(QtSharpPlatform)' == 'win-x64' And Exists('$(QtSharpChartsNativeDir)\QtSharp.Charts.Native.dll')" />
    <None Include="$(QtSharpChartsNativeLinuxDir)\libQtSharp.Charts.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="'$(QtSharpPlatform)' == 'linux-x64' And Exists('$(QtSharpChartsNativeLinuxDir)\libQtSharp.Charts.Native.so')" />
  </ItemGroup>

  <Target Name="QtSharpChartsPackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtSharpChartsDir)\generated')" Text="The QtCharts binding source is missing - run: qtgen codegen model\qtsharp.charts.json out\charts --module charts" />
    <Error Condition="!Exists('$(QtSharpChartsNativeDir)\QtSharp.Charts.Native.dll') and !Exists('$(QtSharpChartsNativeLinuxDir)\libQtSharp.Charts.Native.so')" Text="The QtCharts native glue is missing - run: tools\build-native-module.ps1 -Module charts (Windows) or tools/build-native-module.sh charts (Linux)" />
  </Target>

</Project>
