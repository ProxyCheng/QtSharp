<Project>

  <!-- Imported automatically for any project that references the QtSharp.Charts package. It only
       declares where the native payload lives; the copy itself is in the targets. The core
       package ships the Qt runtime and the QtSharp.Api glue; this one adds Qt6Charts and the
       QtSharp.Charts native glue. -->
  <PropertyGroup>
    <QtSharpChartsNativeDir Condition="'$(QtSharpChartsNativeDir)' == ''">$(MSBuildThisFileDirectory)..\tools\native\</QtSharpChartsNativeDir>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

</Project>
