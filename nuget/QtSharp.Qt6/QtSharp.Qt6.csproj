<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Qt 6 base runtime, the PyQt6-Qt6 slot in the package graph: the Qt DLLs the base
       modules' native glue loads, the MSVC runtime they need, and the Windows platform plugin.
       It carries no managed code; the companion payload is copied next to the consumer's
       executable by buildTransitive. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Qt6.$(QtSharpPlatform)</PackageId>
    <Version>0.23.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>The Qt 6 runtime that QtSharp.Api and its addons load: Qt6Core/Gui/Widgets/Network/Svg/PrintSupport/OpenGL, the MSVC runtime and the Windows platform plugin.</Description>
    <PackageTags>Qt;Qt6;runtime;native</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtRuntimeDir Condition="'$(QtRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Qt\6.12.0\runtime</QtRuntimeDir>
    <!-- The gcc_64 kit's staged runtime (tools/build-qt-kit.sh): lib/ + plugins/. A release pack
         job points this at the artifact the Ubuntu build produced. -->
    <QtLinuxRuntimeDir Condition="'$(QtLinuxRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\qt-kit\runtime</QtLinuxRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="_._" Pack="true" PackagePath="lib/net10.0/" />
    <!-- NuGet only imports buildTransitive/<package id>.props and .targets, and the id
         carries the RID, so the files are packed under the platform-specific name. -->
    <None Include="buildTransitive\QtSharp.Qt6.props" Pack="true" PackagePath="buildTransitive/QtSharp.Qt6.$(QtSharpPlatform).props" />
    <None Include="buildTransitive\QtSharp.Qt6.targets" Pack="true" PackagePath="buildTransitive/QtSharp.Qt6.$(QtSharpPlatform).targets" />
    <!-- win-x64 -->
    <None Include="$(QtRuntimeDir)\Qt6Core.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6Gui.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6Widgets.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6Network.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6Svg.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6SvgWidgets.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6PrintSupport.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6OpenGL.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\Qt6OpenGLWidgets.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\msvcp140*.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\vcruntime140*.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <!-- concrt140 is a redistributable, not a Qt module: some kits ship it and some do not. -->
    <None Include="$(QtRuntimeDir)\concrt140*.dll" Pack="true" PackagePath="tools/native/win-x64/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtRuntimeDir)\platforms\qwindows.dll" Pack="true" PackagePath="tools/native/win-x64/platforms/"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <!-- The headless platforms. A test or a check that must not map a window selects one with
         QT_QPA_PLATFORM=offscreen, and Qt aborts the process when the platform it was told to use
         is not in the build - so a package without these can only run with a desktop. The kit
         stages both (tools/build-qt-kit.ps1); they are packed when it did. -->
    <None Include="$(QtRuntimeDir)\platforms\qoffscreen.dll" Pack="true" PackagePath="tools/native/win-x64/platforms/"  Condition="'$(QtSharpPlatform)' == 'win-x64' And Exists('$(QtRuntimeDir)\platforms\qoffscreen.dll')" />
    <None Include="$(QtRuntimeDir)\platforms\qminimal.dll" Pack="true" PackagePath="tools/native/win-x64/platforms/"  Condition="'$(QtSharpPlatform)' == 'win-x64' And Exists('$(QtRuntimeDir)\platforms\qminimal.dll')" />
    <!-- linux-x64: the whole staged prefix (all Qt libraries and plugin trees, including the
         addons). Every addon package depends on QtSharp.Qt6, so keeping the shared tree here - one
         copy instead of the same libraries in four packages - is both smaller and immune to a
         missing plugin directory. The layout is what the libraries' and plugins' rpaths expect. -->
    <None Include="$(QtLinuxRuntimeDir)\lib\*.so*" Pack="true" PackagePath="tools/native/linux-x64/lib/" Condition="'$(QtSharpPlatform)' == 'linux-x64' And Exists('$(QtLinuxRuntimeDir)\lib')" />
    <None Include="$(QtLinuxRuntimeDir)\qt.conf" Pack="true" PackagePath="tools/native/linux-x64/" Condition="'$(QtSharpPlatform)' == 'linux-x64' And Exists('$(QtLinuxRuntimeDir)\qt.conf')" />
    <!-- NuGet appends the path matched by the wildcard (plugins/<class>/<file>) to PackagePath;
         spelling %(RecursiveDir) as well duplicates the first directory. -->
    <None Include="$(QtLinuxRuntimeDir)\plugins\**\*" Pack="true" PackagePath="tools/native/linux-x64/plugins/" Condition="'$(QtSharpPlatform)' == 'linux-x64' And Exists('$(QtLinuxRuntimeDir)\plugins')" />
  </ItemGroup>

  <Target Name="QtSharpQt6PackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtRuntimeDir)\Qt6Core.dll') and !Exists('$(QtLinuxRuntimeDir)\lib\libQt6Core.so.6')" Text="The Qt runtime is missing under both '$(QtRuntimeDir)' and '$(QtLinuxRuntimeDir)' - see README.md, section Prerequisites." />
  </Target>

</Project>
