<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Qt 6 base runtime, the PyQt6-Qt6 slot in the package graph: the Qt DLLs the base
       modules' native glue loads, the MSVC runtime they need, and the Windows platform plugin.
       It carries no managed code; the companion payload is copied next to the consumer's
       executable by buildTransitive. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>QtSharp.Qt6</PackageId>
    <Version>0.7.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>The Qt 6 runtime that QtSharp.Api and its addons load: Qt6Core/Gui/Widgets/Network/Sql/Svg/PrintSupport/Xml/OpenGL, the SQL driver plugins, the MSVC runtime and the Windows platform plugin.</Description>
    <PackageTags>Qt;Qt6;runtime;native</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtRuntimeDir Condition="'$(QtRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Qt\6.12.0\runtime</QtRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="_._" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="buildTransitive\*" Pack="true" PackagePath="buildTransitive/" />
    <None Include="$(QtRuntimeDir)\Qt6Core.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6Gui.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6Widgets.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6Network.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6Sql.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6Svg.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6SvgWidgets.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6PrintSupport.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6Xml.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6OpenGL.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\Qt6OpenGLWidgets.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\msvcp140*.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\vcruntime140*.dll" Pack="true" PackagePath="tools/native/" />
    <!-- concrt140 is a redistributable, not a Qt module: some kits ship it and some do not. -->
    <None Include="$(QtRuntimeDir)\concrt140*.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\platforms\qwindows.dll" Pack="true" PackagePath="tools/native/platforms/" />
    <!-- The SQL driver plugins QtSql loads. -->
    <None Include="$(QtRuntimeDir)\sqldrivers\*.dll" Pack="true" PackagePath="tools/native/sqldrivers/" Visible="false" />
  </ItemGroup>

  <Target Name="QtSharpQt6PackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtRuntimeDir)\Qt6Core.dll')" Text="The Qt runtime DLLs are missing under '$(QtRuntimeDir)' - see README.md, section Prerequisites." />
    <Error Condition="!Exists('$(QtRuntimeDir)\platforms\qwindows.dll')" Text="The Qt platform plugin is missing at '$(QtRuntimeDir)\platforms\qwindows.dll'." />
  </Target>

</Project>
