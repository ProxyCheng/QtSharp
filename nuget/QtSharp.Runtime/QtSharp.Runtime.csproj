<Project Sdk="Microsoft.NET.Sdk">

  <!-- The binding runtime, the PyQt6-sip slot in the package graph: the managed types every
       generated module uses (handles, QSignal, [QtProperty]/[QtSignal], the wrapper cache and
       marshalling) plus the shared native glue QtSharp.Api.dll that every base module P/Invokes.

       The runtime is Qt-type-free: QObject lives in QtSharp.QtCore, so a Qt-independent runtime
       can be referenced by all ten base assemblies and by every addon. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.Runtime</AssemblyName>
    <RootNamespace>QtSharp.Runtime</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Runtime.$(QtSharpPlatform)</PackageId>
    <Version>0.22.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>QtSharp runtime: the managed handle/signal/marshalling layer shared by every QtSharp binding module, plus the native QtSharp.Api glue.</Description>
    <PackageTags>Qt;Qt6;CSharp;dotnet;binding;interop;runtime</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtSharpApiDir Condition="'$(QtSharpApiDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\api</QtSharpApiDir>
    <!-- The Linux glue lives beside the Windows one in a full checkout; a release pack job can
         point it at the artifact the Ubuntu build produced. -->
    <QtSharpApiLinuxDir Condition="'$(QtSharpApiLinuxDir)' == ''">$(QtSharpApiDir)</QtSharpApiLinuxDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\runtime\ApiRuntime.cs">
      <Link>Runtime\ApiRuntime.cs</Link>
    </Compile>
    <!-- Qt calls function pointers by address long after the call that installed them returns;
         the registry keeps the managed thunk and the caller's delegate rooted. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\runtime\QtCallbackRegistry.cs">
      <Link>Runtime\QtCallbackRegistry.cs</Link>
    </Compile>
    <!-- The pinned-buffer lifetime for Qt's buffer-plus-cleanup constructors. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\runtime\QtPinnedBuffer.cs">
      <Link>Runtime\QtPinnedBuffer.cs</Link>
    </Compile>
    <!-- The binding tests probe the liveness generation counters (OwnershipApi); those members
         are internal to the runtime otherwise. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>QtSharp.BindingTests</_Parameter1>
    </AssemblyAttribute>
    <!-- The QObject/Qt::ConnectionType Connect overloads live next to the generated QtCore
         classes (runtime/QtCore/QSignalConnections.cs) and forward to the internal primitive. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>QtSharp.QtCore</_Parameter1>
    </AssemblyAttribute>
    <!-- Generated QtGui callbacks (QGuiApplication::platformFunction, QOpenGLContext) use the same
         internal wrapping helper; the modules are separate assemblies, so each needs the grant. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>QtSharp.QtGui</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <!-- NuGet only imports buildTransitive/<package id>.props and .targets, and the id
         carries the RID, so the files are packed under the platform-specific name. -->
    <None Include="buildTransitive\QtSharp.Runtime.props" Pack="true" PackagePath="buildTransitive/QtSharp.Runtime.$(QtSharpPlatform).props" />
    <None Include="buildTransitive\QtSharp.Runtime.targets" Pack="true" PackagePath="buildTransitive/QtSharp.Runtime.$(QtSharpPlatform).targets" />
    <None Include="$(QtSharpApiDir)\QtSharp.Api.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" Condition="'$(QtSharpPlatform)' == 'win-x64' And Exists('$(QtSharpApiDir)\QtSharp.Api.dll')" />
    <None Include="$(QtSharpApiLinuxDir)\libQtSharp.Api.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="'$(QtSharpPlatform)' == 'linux-x64' And Exists('$(QtSharpApiLinuxDir)\libQtSharp.Api.so')" />
  </ItemGroup>

  <Target Name="QtSharpRuntimePackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtSharpApiDir)\QtSharp.Api.dll') and !Exists('$(QtSharpApiLinuxDir)\libQtSharp.Api.so')" Text="The native glue is missing - run: powershell -File tools/regen-api.ps1 (or build_api.bat / build_api.sh)" />
  </Target>

</Project>
