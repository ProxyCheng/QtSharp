<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Qt Positioning runtime payload (Qt6Positioning.dll), the companion package a
       QtSharp.Positioning consumer gets automatically. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Positioning.Qt6.$(QtSharpPlatform)</PackageId>
    <Version>0.24.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>The Qt Positioning runtime (Qt6Positioning.dll) loaded by QtSharp.Positioning.</Description>
    <PackageTags>Qt;Qt6;QtPositioning;runtime;native</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtPositioningRuntimeDir Condition="'$(QtPositioningRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Qt\6.12.0\runtime</QtPositioningRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="_._" Pack="true" PackagePath="lib/net10.0/" />
    <!-- NuGet only imports buildTransitive/<package id>.props and .targets, and the id
         carries the RID, so the files are packed under the platform-specific name. -->
    <None Include="buildTransitive\QtSharp.Positioning.Qt6.props" Pack="true" PackagePath="buildTransitive/QtSharp.Positioning.Qt6.$(QtSharpPlatform).props" />
    <None Include="buildTransitive\QtSharp.Positioning.Qt6.targets" Pack="true" PackagePath="buildTransitive/QtSharp.Positioning.Qt6.$(QtSharpPlatform).targets" />
    <None Include="$(QtPositioningRuntimeDir)\Qt6Positioning.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
  </ItemGroup>

  <Target Name="QtSharpPositioningQt6PackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtPositioningRuntimeDir)\Qt6Positioning.dll')" Text="Qt6Positioning.dll is missing under '$(QtPositioningRuntimeDir)' - see README.md, section Prerequisites." />
  </Target>

</Project>
