<Project>

  <!-- Qt6Positioning.dll next to the consumer's executable, on Build and on Publish. Windows only:
       on Linux the base QtSharp.Qt6 package deploys the whole Qt runtime tree. -->
  <Target Name="QtSharpPositioningQt6CopyNativeDeps" AfterTargets="Build" Condition="'$(QtSharpNativeRid)' == 'win-x64'">
    <ItemGroup>
      <_QtSharpPositioningQt6Native Include="$(QtSharpPositioningQt6NativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpPositioningQt6Native)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpPositioningQt6CopyNativeDepsPublish" AfterTargets="Publish" Condition="'$(QtSharpNativeRid)' == 'win-x64'">
    <ItemGroup>
      <_QtSharpPositioningQt6NativePublish Include="$(QtSharpPositioningQt6NativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpPositioningQt6NativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
