<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Qt Multimedia runtime payload, the companion package a QtSharp.Multimedia consumer gets
       automatically: the two libraries and the backend plugin Qt loads from <exe>\multimedia\. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Multimedia.Qt6.$(QtSharpPlatform)</PackageId>
    <Version>0.23.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>The Qt Multimedia runtime (Qt6Multimedia.dll, Qt6MultimediaWidgets.dll, the multimedia backend plugin) loaded by QtSharp.Multimedia.</Description>
    <PackageTags>Qt;Qt6;QtMultimedia;runtime;native</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtMultimediaRuntimeDir Condition="'$(QtMultimediaRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Qt\6.12.0\runtime</QtMultimediaRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="_._" Pack="true" PackagePath="lib/net10.0/" />
    <!-- NuGet only imports buildTransitive/<package id>.props and .targets, and the id
         carries the RID, so the files are packed under the platform-specific name. -->
    <None Include="buildTransitive\QtSharp.Multimedia.Qt6.props" Pack="true" PackagePath="buildTransitive/QtSharp.Multimedia.Qt6.$(QtSharpPlatform).props" />
    <None Include="buildTransitive\QtSharp.Multimedia.Qt6.targets" Pack="true" PackagePath="buildTransitive/QtSharp.Multimedia.Qt6.$(QtSharpPlatform).targets" />
    <None Include="$(QtMultimediaRuntimeDir)\Qt6Multimedia.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtMultimediaRuntimeDir)\Qt6MultimediaWidgets.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <!-- The ffmpeg backend's own dependencies; the plugin loads without them but cannot decode. -->
    <None Include="$(QtMultimediaRuntimeDir)\avcodec-*.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtMultimediaRuntimeDir)\avformat-*.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtMultimediaRuntimeDir)\avutil-*.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtMultimediaRuntimeDir)\swresample-*.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtMultimediaRuntimeDir)\swscale-*.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
    <None Include="$(QtMultimediaRuntimeDir)\plugins\multimedia\*.dll" Pack="true" PackagePath="tools/native/win-x64/multimedia/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
  </ItemGroup>

  <Target Name="QtSharpMultimediaQt6PackCheck" BeforeTargets="GenerateNuspec">
    <!-- Exists() has no wildcard support, so the ffmpeg check collects first and asks the item
         list; a missing avcodec is the difference between "loads" and "loads but cannot decode". -->
    <ItemGroup>
      <_QtSharpMultimediaFfmpeg Include="$(QtMultimediaRuntimeDir)\avcodec-*.dll" />
    </ItemGroup>
    <Error Condition="!Exists('$(QtMultimediaRuntimeDir)\Qt6Multimedia.dll')" Text="Qt6Multimedia.dll is missing under '$(QtMultimediaRuntimeDir)' - see README.md, section Prerequisites." />
    <Error Condition="!Exists('$(QtMultimediaRuntimeDir)\plugins\multimedia')" Text="The multimedia backend plugin is missing under '$(QtMultimediaRuntimeDir)\plugins\multimedia'." />
    <Error Condition="'@(_QtSharpMultimediaFfmpeg)' == ''" Text="The ffmpeg runtime DLLs (avcodec/avformat/avutil/sw*) are missing under '$(QtMultimediaRuntimeDir)' - the backend cannot decode without them." />
  </Target>

</Project>
