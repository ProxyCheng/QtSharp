<Project>

  <!-- Qt6Multimedia.dll/Qt6MultimediaWidgets.dll next to the consumer's executable and the backend
       plugin under <exe>\multimedia\, on Build and on Publish. -->
  <Target Name="QtSharpMultimediaQt6CopyNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <_QtSharpMultimediaQt6Native Include="$(QtSharpMultimediaQt6NativeDir)*.dll" />
      <_QtSharpMultimediaQt6Plugin Include="$(QtSharpMultimediaQt6NativeDir)multimedia\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpMultimediaQt6Native)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_QtSharpMultimediaQt6Plugin)" DestinationFolder="$(OutDir)multimedia\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpMultimediaQt6CopyNativeDepsPublish" AfterTargets="Publish">
    <ItemGroup>
      <_QtSharpMultimediaQt6NativePublish Include="$(QtSharpMultimediaQt6NativeDir)*.dll" />
      <_QtSharpMultimediaQt6PluginPublish Include="$(QtSharpMultimediaQt6NativeDir)multimedia\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpMultimediaQt6NativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_QtSharpMultimediaQt6PluginPublish)" DestinationFolder="$(PublishDir)multimedia\" SkipUnchangedFiles="true" />
  </Target>

</Project>
