<Project>

  <!-- Qt6WebSockets.dll next to the consumer's executable, on Build and on Publish. -->
  <Target Name="QtSharpWebSocketsQt6CopyNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <_QtSharpWebSocketsQt6Native Include="$(QtSharpWebSocketsQt6NativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpWebSocketsQt6Native)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpWebSocketsQt6CopyNativeDepsPublish" AfterTargets="Publish">
    <ItemGroup>
      <_QtSharpWebSocketsQt6NativePublish Include="$(QtSharpWebSocketsQt6NativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpWebSocketsQt6NativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
