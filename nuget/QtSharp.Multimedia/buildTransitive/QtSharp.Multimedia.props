<Project>

  <!-- Imported automatically for any project that references the QtSharp.Multimedia package. It
       only declares where the native payload lives; the copy itself is in the targets. -->
  <PropertyGroup>
    <QtSharpMultimediaNativeDir Condition="'$(QtSharpMultimediaNativeDir)' == ''">$(MSBuildThisFileDirectory)..\tools\native\</QtSharpMultimediaNativeDir>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

</Project>
