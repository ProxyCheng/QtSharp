<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Qt Charts runtime payload, the companion package a QtSharp.Charts consumer gets
       automatically (PyQt6-Charts depends on PyQt6-Qt6 the same way). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

  <!-- One package per platform: the release packs this project once with
       -p:QtSharpPlatform=win-x64 and once with linux-x64. The managed assemblies are
       identical; the native payload below is the matching half only. -->
  <QtSharpPlatform Condition="'$(QtSharpPlatform)' == ''">win-x64</QtSharpPlatform>
    <PackageId>QtSharp.Charts.Qt6.$(QtSharpPlatform)</PackageId>
    <Version>0.19.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>The Qt Charts runtime (Qt6Charts.dll) loaded by QtSharp.Charts.</Description>
    <PackageTags>Qt;Qt6;QtCharts;runtime;native</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtChartsRuntimeDir Condition="'$(QtChartsRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Qt\6.12.0\runtime</QtChartsRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="_._" Pack="true" PackagePath="lib/net10.0/" />
    <!-- NuGet only imports buildTransitive/<package id>.props and .targets, and the id
         carries the RID, so the files are packed under the platform-specific name. -->
    <None Include="buildTransitive\QtSharp.Charts.Qt6.props" Pack="true" PackagePath="buildTransitive/QtSharp.Charts.Qt6.$(QtSharpPlatform).props" />
    <None Include="buildTransitive\QtSharp.Charts.Qt6.targets" Pack="true" PackagePath="buildTransitive/QtSharp.Charts.Qt6.$(QtSharpPlatform).targets" />
    <None Include="$(QtChartsRuntimeDir)\Qt6Charts.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false"  Condition="'$(QtSharpPlatform)' == 'win-x64'" />
  </ItemGroup>

  <Target Name="QtSharpChartsQt6PackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtChartsRuntimeDir)\Qt6Charts.dll')" Text="Qt6Charts.dll is missing under '$(QtChartsRuntimeDir)' - see README.md, section Prerequisites." />
  </Target>

</Project>
