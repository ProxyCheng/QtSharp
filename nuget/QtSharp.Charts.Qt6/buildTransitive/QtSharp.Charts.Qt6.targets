<Project>

  <!-- Qt6Charts next to the consumer's executable, on Build and on Publish. Windows only: on Linux
       the base QtSharp.Qt6 package already deploys the whole Qt runtime tree, addon libraries
       included, so this package has no separate payload there. -->
  <Target Name="QtSharpChartsQt6CopyNativeDeps" AfterTargets="Build" Condition="'$(QtSharpNativeRid)' == 'win-x64'">
    <ItemGroup>
      <_QtSharpChartsQt6Native Include="$(QtSharpChartsQt6NativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpChartsQt6Native)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpChartsQt6CopyNativeDepsPublish" AfterTargets="Publish" Condition="'$(QtSharpNativeRid)' == 'win-x64'">
    <ItemGroup>
      <_QtSharpChartsQt6NativePublish Include="$(QtSharpChartsQt6NativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpChartsQt6NativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
