<Project Sdk="Microsoft.NET.Sdk">

  <!-- The base binding as one package of ten assemblies, one per Qt module - the PyQt6 shape:
       `PyQt6` (here `QtSharp.Api`) is a single install whose importable modules have their own
       namespaces. The Qt runtime is not bundled here; it comes from the QtSharp.Qt6 dependency,
       and the managed/native runtime from QtSharp.Runtime.

       This project has no source of its own: it builds the ten module projects and packs their
       assemblies with the package metadata. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <PackageId>QtSharp.Api</PackageId>
    <Version>0.18.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>Qt for .NET: the generated C# binding as nine module assemblies (QtCore, QtGui, QtWidgets, QtNetwork, QtSvg, QtSvgWidgets, QtPrintSupport, QtOpenGL, QtOpenGLWidgets), generated from the Qt 6.12 headers.</Description>
    <PackageTags>Qt;Qt6;CSharp;dotnet;binding;interop;gui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built here, packed below. PrivateAssets keeps the internal module projects out of the
         package's dependency list; ReferenceOutputAssembly keeps their assemblies out of this
         project's (empty) compile output. -->
    <ProjectReference Include="Modules\QtSharp.QtCore\QtSharp.QtCore.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtGui\QtSharp.QtGui.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtNetwork\QtSharp.QtNetwork.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtSvg\QtSharp.QtSvg.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtSvgWidgets\QtSharp.QtSvgWidgets.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtPrintSupport\QtSharp.QtPrintSupport.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtOpenGL\QtSharp.QtOpenGL.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.QtOpenGLWidgets\QtSharp.QtOpenGLWidgets.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />

    <!-- The package's two dependencies: the binding runtime (managed + native glue) and the Qt
         runtime payload. Both are packages of their own, exactly like PyQt6-sip and PyQt6-Qt6. -->
    <ProjectReference Include="..\QtSharp.Runtime\QtSharp.Runtime.csproj" />
    <ProjectReference Include="..\QtSharp.Qt6\QtSharp.Qt6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="Modules\QtSharp.QtCore\bin\$(Configuration)\net10.0\QtSharp.QtCore.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtGui\bin\$(Configuration)\net10.0\QtSharp.QtGui.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtWidgets\bin\$(Configuration)\net10.0\QtSharp.QtWidgets.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtNetwork\bin\$(Configuration)\net10.0\QtSharp.QtNetwork.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtSvg\bin\$(Configuration)\net10.0\QtSharp.QtSvg.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtSvgWidgets\bin\$(Configuration)\net10.0\QtSharp.QtSvgWidgets.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtPrintSupport\bin\$(Configuration)\net10.0\QtSharp.QtPrintSupport.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtOpenGL\bin\$(Configuration)\net10.0\QtSharp.QtOpenGL.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.QtOpenGLWidgets\bin\$(Configuration)\net10.0\QtSharp.QtOpenGLWidgets.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
  </ItemGroup>

  <Target Name="QtSharpApiPackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('Modules\QtSharp.QtCore\bin\$(Configuration)\net10.0\QtSharp.QtCore.dll')" Text="The base module assemblies are missing - run: qtgen codegen for the split models (tools\regen-api.ps1)." />
  </Target>

</Project>
