<Project Sdk="Microsoft.NET.Sdk">

  <!-- The binding as a *package*, so a consumer only writes:
         <PackageReference Include="QtSharp.Api" Version="..." />
       and then `using QtSharp.Api;`.

       It ships three things:
         * lib/net10.0/QtSharp.dll        the managed binding + runtime, compiled here
         * tools/native/QtSharp.Api.dll   the native glue (the C++ wrapper)
         * tools/native/*.dll, platforms/  the Qt runtime the glue needs
       buildTransitive/ copies the native payload next to the consumer's executable, on
       both Build and Publish.

       The managed assembly is deliberately *not* named QtSharp.Api.dll: the native glue
       already owns that name (ApiRuntime.Library), and two files cannot share it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp</AssemblyName>
    <RootNamespace>QtSharp.Api</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The generated binding keeps the C ABI in pointers; only x64 is supported. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <PackageId>QtSharp.Api</PackageId>
    <Version>0.1.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>Qt for .NET: the generated C# binding plus the native glue and the Qt runtime. Reference it and write Qt applications in C#.</Description>
    <PackageTags>Qt;Qt6;CSharp;dotnet;binding;interop;gui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtSharpApiDir Condition="'$(QtSharpApiDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\api</QtSharpApiDir>
    <QtRuntimeDir Condition="'$(QtRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\..\Qt\6.11.0\runtime</QtRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\runtime\ApiRuntime.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\runtime\ApiApplication.cs" />
    <Compile Include="$(QtSharpApiDir)\QtSharp.Api.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\*" Pack="true" PackagePath="buildTransitive/" />
    <None Include="$(QtSharpApiDir)\QtSharp.Api.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\*.dll" Pack="true" PackagePath="tools/native/" />
    <None Include="$(QtRuntimeDir)\platforms\qwindows.dll" Pack="true" PackagePath="tools/native/platforms/" />
  </ItemGroup>

  <Target Name="QtSharpApiPackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(QtSharpApiDir)\QtSharp.Api.cs')" Text="The binding source is missing - run: powershell -File tools\regen-api.ps1" />
    <Error Condition="!Exists('$(QtSharpApiDir)\QtSharp.Api.dll')" Text="The native glue is missing - run: powershell -File tools\regen-api.ps1" />
    <Error Condition="!Exists('$(QtRuntimeDir)\Qt6Core.dll')" Text="The Qt runtime DLLs are missing under '$(QtRuntimeDir)' - see README.md, section Prerequisites." />
    <Error Condition="!Exists('$(QtRuntimeDir)\platforms\qwindows.dll')" Text="The Qt platform plugin is missing at '$(QtRuntimeDir)\platforms\qwindows.dll'." />
  </Target>

</Project>
