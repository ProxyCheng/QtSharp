<Project Sdk="Microsoft.NET.Sdk">

  <!-- One Qt base module = one assembly and one C# namespace, packed into QtSharp.Api together
       with the other ten. The assembly is built from the split model (model/qtsharp.qtsql.json,
       produced by `qtgen split-core`) and only references the modules it builds on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.QtSql</AssemblyName>
    <RootNamespace>QtSharp.QtSql</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\out\qtsql\generated\**\*.cs">
      <Link>Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <!-- The BCL-facing half: LINQ-friendly rows and typed reads over QSqlQuery/QSqlRecord. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\runtime\QtSql\*.cs">
      <Link>Runtime\QtSql\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\QtSharp.Runtime\QtSharp.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\QtSharp.QtCore\QtSharp.QtCore.csproj" />
  </ItemGroup>

</Project>
