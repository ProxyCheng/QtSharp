<Project Sdk="Microsoft.NET.Sdk">

  <!-- One Qt base module = one assembly and one C# namespace, packed into QtSharp.Api together
       with the other nine. The assembly is built from the split model (model/qtsharp.qtgui.json,
       produced by `qtgen split-core`) and only references the modules it builds on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.QtGui</AssemblyName>
    <RootNamespace>QtSharp.QtGui</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\out\qtgui\generated\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\runtime\QtGui\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\QtSharp.Runtime\QtSharp.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\QtSharp.QtCore\QtSharp.QtCore.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
