<Project Sdk="Microsoft.NET.Sdk">

  <!-- One Qt base module = one assembly and one C# namespace, packed into QtSharp.Api together
       with the other nine. The assembly is built from the split model (model/qtsharp.qtopenglwidgets.json,
       produced by `qtgen split-core`) and only references the modules it builds on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>QtSharp.QtOpenGLWidgets</AssemblyName>
    <RootNamespace>QtSharp.QtOpenGLWidgets</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\out\qtopenglwidgets\generated\**\*.cs">
      <Link>Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\QtSharp.Runtime\QtSharp.Runtime.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\QtSharp.QtCore\QtSharp.QtCore.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\QtSharp.QtGui\QtSharp.QtGui.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\QtSharp.QtOpenGL\QtSharp.QtOpenGL.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\QtSharp.QtWidgets\QtSharp.QtWidgets.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
