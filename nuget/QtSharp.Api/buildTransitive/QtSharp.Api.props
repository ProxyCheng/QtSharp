<Project>

  <!-- Imported automatically for any project that references the QtSharp.Api package.
       It only declares where the native payload lives; the copy itself is in the targets. -->
  <PropertyGroup>
    <QtSharpNativeDir Condition="'$(QtSharpNativeDir)' == ''">$(MSBuildThisFileDirectory)..\tools\native\</QtSharpNativeDir>
    <!-- The native glue is x64 only, so the process must be x64 too. -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

</Project>
