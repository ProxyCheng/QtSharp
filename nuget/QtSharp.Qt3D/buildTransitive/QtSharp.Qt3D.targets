<Project>

  <!-- The six Qt3D native glues next to the consumer's executable, on Build and on Publish. The
       Qt3D runtime DLLs and the renderer/geometry/scene plugins are the QtSharp.Qt3D.Qt6
       package's payload. -->
  <Target Name="QtSharpQt3DCopyNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <_QtSharpQt3DNative Include="$(QtSharpQt3DNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpQt3DNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="QtSharpQt3DCopyNativeDepsPublish" AfterTargets="Publish">
    <ItemGroup>
      <_QtSharpQt3DNativePublish Include="$(QtSharpQt3DNativeDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_QtSharpQt3DNativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
