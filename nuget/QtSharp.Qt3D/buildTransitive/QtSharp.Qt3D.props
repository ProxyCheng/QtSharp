<Project>

  <!-- Imported automatically for any project that references the QtSharp.Qt3D package. It only
       declares where the native payload lives; the copy itself is in the targets. The core
       package ships the Qt runtime and the QtSharp.Api glue; this one adds the six Qt3D
       libraries, their renderer/loader plugins, and the QtSharp.Qt3D native glue. -->
  <PropertyGroup>
    <QtSharpQt3DNativeDir Condition="'$(QtSharpQt3DNativeDir)' == ''">$(MSBuildThisFileDirectory)..\tools\native\</QtSharpQt3DNativeDir>
    <!-- The native glue is x64 only, so the process must be x64 too. -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
  </PropertyGroup>

</Project>
