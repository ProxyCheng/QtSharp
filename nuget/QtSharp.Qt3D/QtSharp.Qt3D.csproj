<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Qt3D addon as one package containing six assemblies, one per Qt module:
       QtSharp.Qt3DCore, QtSharp.Qt3DRender, QtSharp.Qt3DInput, QtSharp.Qt3DLogic,
       QtSharp.Qt3DAnimation and QtSharp.Qt3DExtras. This is the PyQt6-3D / PySide6-Addons
       shape: one install, separate importable modules with their own namespaces, and the
       dependency graph Qt itself uses between the modules.

       The module projects live under Modules/; this project only builds them and packs their
       outputs together with the native glue and the Qt3D runtime payload. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <PackageId>QtSharp.Qt3D</PackageId>
    <Version>0.17.0</Version>
    <Authors>ProxyCheng</Authors>
    <Description>Qt 3D for .NET as six module assemblies (Qt3DCore, Qt3DRender, Qt3DInput, Qt3DLogic, Qt3DAnimation, Qt3DExtras), generated from the Qt 6.12 headers. References QtSharp.Api.</Description>
    <PackageTags>Qt;Qt6;Qt3D;CSharp;dotnet;binding;interop;3d</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ProxyCheng/QtSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ProxyCheng/QtSharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <QtSharpQt3DModules>qt3dcore;qt3drender;qt3dinput;qt3dlogic;qt3danimation;qt3dextras</QtSharpQt3DModules>
    <QtSharpQt3DNativeDir Condition="'$(QtSharpQt3DNativeDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\api-modules</QtSharpQt3DNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build the six module assemblies; they are packed explicitly below. The Api project
         reference turns into the package dependency. -->
    <ProjectReference Include="Modules\QtSharp.Qt3DCore\QtSharp.Qt3DCore.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.Qt3DRender\QtSharp.Qt3DRender.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.Qt3DInput\QtSharp.Qt3DInput.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.Qt3DLogic\QtSharp.Qt3DLogic.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.Qt3DAnimation\QtSharp.Qt3DAnimation.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="Modules\QtSharp.Qt3DExtras\QtSharp.Qt3DExtras.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Api\QtSharp.Api.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\QtSharp.Qt3D.Qt6\QtSharp.Qt3D.Qt6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\*" Pack="true" PackagePath="buildTransitive/" />

    <None Include="Modules\QtSharp.Qt3DCore\bin\$(Configuration)\net10.0\QtSharp.Qt3DCore.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.Qt3DRender\bin\$(Configuration)\net10.0\QtSharp.Qt3DRender.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.Qt3DInput\bin\$(Configuration)\net10.0\QtSharp.Qt3DInput.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.Qt3DLogic\bin\$(Configuration)\net10.0\QtSharp.Qt3DLogic.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.Qt3DAnimation\bin\$(Configuration)\net10.0\QtSharp.Qt3DAnimation.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="Modules\QtSharp.Qt3DExtras\bin\$(Configuration)\net10.0\QtSharp.Qt3DExtras.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />

    <None Include="$(QtSharpQt3DNativeDir)\qt3dcore\QtSharp.Qt3DCore.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3drender\QtSharp.Qt3DRender.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3dinput\QtSharp.Qt3DInput.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3dlogic\QtSharp.Qt3DLogic.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3danimation\QtSharp.Qt3DAnimation.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3dextras\QtSharp.Qt3DExtras.Native.dll" Pack="true" PackagePath="tools/native/win-x64/" Visible="false" />

    <None Include="$(QtSharpQt3DNativeDir)\qt3dcore\libQtSharp.Qt3DCore.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="Exists('$(QtSharpQt3DNativeDir)\qt3dcore\libQtSharp.Qt3DCore.Native.so')" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3drender\libQtSharp.Qt3DRender.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="Exists('$(QtSharpQt3DNativeDir)\qt3drender\libQtSharp.Qt3DRender.Native.so')" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3dinput\libQtSharp.Qt3DInput.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="Exists('$(QtSharpQt3DNativeDir)\qt3dinput\libQtSharp.Qt3DInput.Native.so')" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3dlogic\libQtSharp.Qt3DLogic.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="Exists('$(QtSharpQt3DNativeDir)\qt3dlogic\libQtSharp.Qt3DLogic.Native.so')" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3danimation\libQtSharp.Qt3DAnimation.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="Exists('$(QtSharpQt3DNativeDir)\qt3danimation\libQtSharp.Qt3DAnimation.Native.so')" />
    <None Include="$(QtSharpQt3DNativeDir)\qt3dextras\libQtSharp.Qt3DExtras.Native.so" Pack="true" PackagePath="tools/native/linux-x64/" Visible="false" Condition="Exists('$(QtSharpQt3DNativeDir)\qt3dextras\libQtSharp.Qt3DExtras.Native.so')" />

  </ItemGroup>

  <Target Name="QtSharpQt3DPackCheck" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('Modules\QtSharp.Qt3DCore\bin\$(Configuration)\net10.0\QtSharp.Qt3DCore.dll')" Text="The Qt3DCore assembly is missing - build the module projects first." />
    <Error Condition="!Exists('$(QtSharpQt3DNativeDir)\qt3dcore\QtSharp.Qt3DCore.Native.dll') and !Exists('$(QtSharpQt3DNativeDir)\qt3dcore\libQtSharp.Qt3DCore.Native.so')" Text="The Qt3DCore native glue is missing - run the build-native-module script for the qt3dcore module." />
  </Target>

</Project>
