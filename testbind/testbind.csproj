<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>testapp</AssemblyName>
    <!-- The binding is compiled inside QtSharp.Demos; this app only dispatches to it. -->
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <!-- The native QtSharp.Api.dll, the Qt runtime DLLs and the platform plugin. -->
  <Import Project="..\QtSharp.Api.props" />

  <!-- The official demos (and the binding + runtime they are built on) and the binding tests. -->
  <ItemGroup>
    <ProjectReference Include="..\demos\QtSharp.Demos.csproj" />
    <ProjectReference Include="../tests/QtSharp.BindingTests.csproj" />
  </ItemGroup>

  <!-- The QtMultimedia extension's native glue and Qt runtime plugin, the way the package's
       buildTransitive would copy them for a consumer. The Qt runtime location comes from
       QtSharp.Api.props (QT_RUNTIME_DIR in CI), not from a repository-relative guess. On Linux the
       props already stages the whole plugins/ tree, so only the glue libraries are copied. -->
  <Target Name="CopyQtMultimediaNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <QtMultimediaNative Include="..\out\api-modules\qtmultimedia\$(QtSharpNativePrefix)QtSharp.QtMultimedia.Native$(QtSharpNativeSuffix)" />
      <QtMultimediaPlugin Include="$(QtRuntimeDir)\plugins\multimedia\*.dll" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
      <QtPositioningNative Include="..\out\api-modules\qtpositioning\$(QtSharpNativePrefix)QtSharp.QtPositioning.Native$(QtSharpNativeSuffix)" />
      <!-- The Qt3D value-type test lives in the binding tests; the six managed Qt3D assemblies
           come in through the tests project, their native glue has to be copied here. -->
      <Qt3DNative Include="..\out\api-modules\qt3dcore\$(QtSharpNativePrefix)QtSharp.Qt3DCore.Native$(QtSharpNativeSuffix)" />
      <Qt3DNative Include="..\out\api-modules\qt3danimation\$(QtSharpNativePrefix)QtSharp.Qt3DAnimation.Native$(QtSharpNativeSuffix)" />
      <Qt3DNative Include="..\out\api-modules\qt3drender\$(QtSharpNativePrefix)QtSharp.Qt3DRender.Native$(QtSharpNativeSuffix)" />
      <Qt3DNative Include="..\out\api-modules\qt3dinput\$(QtSharpNativePrefix)QtSharp.Qt3DInput.Native$(QtSharpNativeSuffix)" />
      <Qt3DNative Include="..\out\api-modules\qt3dlogic\$(QtSharpNativePrefix)QtSharp.Qt3DLogic.Native$(QtSharpNativeSuffix)" />
      <Qt3DNative Include="..\out\api-modules\qt3dextras\$(QtSharpNativePrefix)QtSharp.Qt3DExtras.Native$(QtSharpNativeSuffix)" />
    </ItemGroup>
    <Copy SourceFiles="@(QtMultimediaNative);@(QtPositioningNative);@(Qt3DNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QtMultimediaPlugin)" DestinationFolder="$(OutDir)multimedia\" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>

</Project>
