<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>testapp</AssemblyName>
  </PropertyGroup>

  <!-- The new pipeline's binding (out/api/QtSharp.Api.cs + runtime/ApiRuntime.cs + the native
       DLLs and the Qt runtime). The legacy pipeline below is only here for the 15 old demos. -->
  <Import Project="..\QtSharp.Api.props" />

  <ItemGroup>
    <Reference Include="CppSharp.Runtime">
      <HintPath>D:\QtSharp\lib\CppSharp.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The legacy binding (QtSharp.dll), which the old demos in this project still use. -->
  <Target Name="CopyLegacyNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <QtSharpNative Include="D:\QtSharp\out\native\QtSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(QtSharpNative)" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
