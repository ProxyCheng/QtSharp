<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>testapp</AssemblyName>
    <!-- The binding is compiled inside QtSharp.Demos; this app only dispatches to it. -->
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <!-- The native QtSharp.Api.dll, the Qt runtime DLLs and the platform plugin. -->
  <Import Project="..\QtSharp.Api.props" />

  <!-- The official demos (and the binding + runtime they are built on) and the binding tests. -->
  <ItemGroup>
    <ProjectReference Include="..\demos\QtSharp.Demos.csproj" />
    <ProjectReference Include="../tests/QtSharp.BindingTests.csproj" />
  </ItemGroup>

  <!-- The QtMultimedia extension's native glue and Qt runtime plugin, the way the package's
       buildTransitive would copy them for a consumer. The Qt runtime location comes from
       QtSharp.Api.props (QT_RUNTIME_DIR in CI), not from a repository-relative guess. -->
  <Target Name="CopyQtMultimediaNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <QtMultimediaNative Include="..\out\api-modules\qtmultimedia\QtSharp.QtMultimedia.Native.dll" />
      <QtMultimediaPlugin Include="$(QtRuntimeDir)\plugins\multimedia\*.dll" />
      <QtPositioningNative Include="..\out\api-modules\qtpositioning\QtSharp.QtPositioning.Native.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(QtMultimediaNative);@(QtPositioningNative)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(QtMultimediaPlugin)" DestinationFolder="$(OutDir)multimedia\" SkipUnchangedFiles="true" />
  </Target>

</Project>
