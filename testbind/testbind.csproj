<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>testapp</AssemblyName>
    <!-- The binding is compiled inside QtSharp.Demos; this app only dispatches to it. -->
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <!-- The native QtSharp.Api.dll, the Qt runtime DLLs and the platform plugin. -->
  <Import Project="..\QtSharp.Api.props" />

  <!-- The official demos (and the binding + runtime they are built on) and the binding tests. -->
  <ItemGroup>
    <ProjectReference Include="..\demos\QtSharp.Demos.csproj" />
    <ProjectReference Include="../tests/QtSharp.BindingTests.csproj" />
  </ItemGroup>

  <!-- The QtWebSockets extension's native glue and Qt runtime DLL, the way the package's
       buildTransitive would copy them for a consumer. -->
  <Target Name="CopyQtWebSocketsNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <QtWebSocketsNative Include="..\out\api-modules\qtwebsockets\QtSharp.QtWebSockets.Native.dll" />
      <QtWebSocketsRuntime Include="..\Qt\6.12.0\runtime\Qt6WebSockets.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(QtWebSocketsNative);@(QtWebSocketsRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
