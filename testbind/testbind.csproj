<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>testapp</AssemblyName>
    <!-- The binding is compiled inside QtSharp.Demos; this app only dispatches to it. -->
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <!-- The native QtSharp.Api.dll, the Qt runtime DLLs and the platform plugin. -->
  <Import Project="..\QtSharp.Api.props" />

  <!-- Every ported example (and the QtSharp.Api binding + runtime they are built on). -->
  <ItemGroup>
    <ProjectReference Include="..\demos\QtSharp.Demos.csproj" />
  </ItemGroup>

</Project>
