<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>qt3d</AssemblyName>
    <!-- The binding is compiled inside QtSharp.Demos; this app only uses it (and can run the
         ported examples), so it must not compile it a second time. -->
    <QtSharpCompileBinding>false</QtSharpCompileBinding>
  </PropertyGroup>

  <!-- The native QtSharp.Api.dll, the Qt runtime DLLs and the platform plugin, in one import. -->
  <Import Project="..\..\QtSharp.Api.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\nuget\QtSharp.Qt3D\QtSharp.Qt3D.csproj" />
  </ItemGroup>

  <!-- The Qt3D native glue and the six Qt3D runtime DLLs. The plugin directories are laid out
       the way Qt expects them next to the executable. -->
  <Target Name="CopyQt3DNativeDeps" AfterTargets="Build">
    <ItemGroup>
      <Qt3DNative Include="..\..\out\api-modules\qt3d\QtSharp.Qt3D.Native.dll" />
      <Qt3DRuntime Include="..\..\Qt\6.11.0\runtime\Qt63D*.dll" />
      <Qt3DRenderer Include="..\..\Qt\6.11.0\runtime\plugins\renderers\*.dll" />
      <Qt3DGeometryLoader Include="..\..\Qt\6.11.0\runtime\plugins\geometryloaders\*.dll" />
      <Qt3DSceneParser Include="..\..\Qt\6.11.0\runtime\plugins\sceneparsers\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(Qt3DNative);@(Qt3DRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Qt3DRenderer)" DestinationFolder="$(OutDir)renderers\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Qt3DGeometryLoader)" DestinationFolder="$(OutDir)geometryloaders\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Qt3DSceneParser)" DestinationFolder="$(OutDir)sceneparsers\" SkipUnchangedFiles="true" />
  </Target>

</Project>
